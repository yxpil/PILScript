// PILScript 基础语法冒烟测试
let greeting = "PILScript";
print(greeting, "已就绪");

// 函数与递归
function fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
print("fib(10) =", fib(10));

// 闭包
function counter() {
    let n = 0;
    return function() {
        n += 1;
        return n;
    };
}
let tick = counter();
tick();
tick();
print("闭包计数:", tick());

// 数组与对象
let arr = [1, 2, 3];
push(arr, 4);
print("数组:", arr, "长度:", arr.length);
let user = { name: "Ada", age: 36 };
user.lang = "数学";
print("对象:", user);
print("键:", keys(user));

// 循环
let sum = 0;
for (let i = 1; i <= 100; i += 1) {
    sum += i;
}
print("1..100 求和 =", sum);

let evens = [];
let j = 0;
while (j < 10) {
    if (j % 2 == 0) {
        push(evens, j);
    }
    j += 1;
}
print("偶数:", evens);

assert(sum == 5050, "求和应该等于 5050");
print("全部断言通过");
